# Copy to .env and fill in real values. .env is gitignored.
# On the live server these are injected via docker run -e (deploy/ec2/run-container.sh).

PORT=3000

# --- Inbound PUSH auth (Myntra calls our server) ---
MYNTRA_WEBHOOK_TOKEN=

# --- Outbound PULL credentials (we call Myntra's Seller API) ---
MYNTRA_API_BASE=https://api-integration.myntra.com
MYNTRA_MERCHANT_ID=
MYNTRA_SECRET_KEY=
MYNTRA_PARTNER_STORE=MYNTRA

# --- Warehouse dashboard (/orders) ---
# Empty = open access. Set a value to require /orders?key=<value>
DASHBOARD_KEY=
